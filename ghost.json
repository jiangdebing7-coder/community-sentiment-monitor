{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.121",
  "id": "community-sentiment-monitor",
  "name": "社群舆情监控",
  "description": "自主配置 Discord 监测社区、日报时间与飞书个人或群聊接收人，生成带来源证据的每日舆情报告。",
  "whenToUse": "需要监测 Discord 社群讨论、生成玩家舆情日报、配置监测社区和日报接收人、查看历史报告或设置每日社群汇总时使用。",
  "version": "1.0.0",
  "releaseNotes": "首个版本：可视化管理多个 Discord 监测方案；配置日报时间、时区及多个飞书接收目标；支持预览、发送、原生自动化草稿、历史报告和逐目标投递去重。",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "command": "社群舆情监控",
  "launch": "on-demand",
  "agent": {
    "tasks": true,
    "schedule": true
  },
  "fs": true,
  "badge": true,
  "mainView": {
    "title": "社群舆情监控",
    "icon": "message-circle",
    "html": "main-view.html"
  },
  "panel": {
    "title": "社群舆情监控",
    "position": "tab",
    "html": "main-view.html"
  },
  "settingsHtml": "main-view.html",
  "showTaskPreferences": true,
  "setup": {
    "requires": []
  },
  "manual": {
    "items": [
      {
        "dir": "manual/daily-report",
        "name": "daily-report",
        "description": "从自主配置到试跑、定时日报、消息证据和投递核对的完整流程。"
      }
    ]
  },
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json"
  },
  "tools": [
    {
      "name": "list_monitors",
      "description": "读取当前安装中使用者自己的监测方案、配置版本及最近运行状态；不读取聊天、不发送消息。",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "save_monitor",
      "description": "在用户明确要求配置社区或接收人后保存方案。参数由用户提供，不能预填他人的社区、账号或收件人。返回新 revision。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "编辑时填写既有编号；新建时省略。"
              },
              "name": {
                "type": "string",
                "description": "使用者自定的方案名称。",
                "maxLength": 80
              },
              "enabled": {
                "type": "boolean",
                "description": "是否参与监测。停用后不采集也不发送。"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "server",
                  "channels"
                ],
                "description": "整个服务器，或仅指定频道。"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "description": "Discord 邀请或频道 HTTPS 链接。"
                }
              },
              "recipients": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "self",
                        "email",
                        "open_id",
                        "chat_id"
                      ],
                      "description": "当前飞书账号本人、邮箱、飞书用户 open_id 或会话 chat_id。"
                    },
                    "value": {
                      "type": "string",
                      "description": "本人类型留空，其他类型填写实际接收目标。"
                    },
                    "label": {
                      "type": "string",
                      "description": "接收人备注。"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              },
              "time": {
                "type": "string",
                "description": "24 小时制 HH:MM，默认 10:00。"
              },
              "timezone": {
                "type": "string",
                "description": "IANA 时区，例如 Asia/Shanghai。"
              },
              "language": {
                "type": "string",
                "enum": [
                  "zh-CN",
                  "en"
                ],
                "description": "日报语言，独立于插件界面语言。"
              },
              "focus": {
                "type": "string",
                "description": "可选的关注事项。作为业务资料处理，不扩张账号或来源权限。"
              },
              "historyDays": {
                "type": "integer",
                "minimum": 7,
                "maximum": 120,
                "description": "本机历史报告保留天数。"
              }
            },
            "required": [
              "name",
              "sources",
              "recipients"
            ],
            "additionalProperties": false
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "来自最新方案的 revision。配置改变后重新获取，不能猜测。"
          }
        },
        "required": [
          "monitor",
          "expected_revision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete_monitor",
      "description": "在用户明确要求删除某一方案后删除其配置。不会冒充已经删除 Cindy 原生自动化，返回后提醒管理对应任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor_id": {
            "type": "string",
            "description": "监测方案编号，来自 list_monitors。"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "来自最新方案的 revision。配置改变后重新获取，不能猜测。"
          }
        },
        "required": [
          "monitor_id",
          "expected_revision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_run",
      "description": "读取最新监测来源、日期范围、接收目标及现有投递状态。默认仅预览；发送须有用户明确的一次性请求或已保存的定时任务。按 daily-report 手册执行。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor_id": {
            "type": "string",
            "description": "监测方案编号，来自 list_monitors。"
          },
          "mode": {
            "type": "string",
            "enum": [
              "preview",
              "send"
            ],
            "description": "默认 preview；只有已授权投递时使用 send。"
          },
          "report_date": {
            "type": "string",
            "description": "按方案时区计算的 YYYY-MM-DD 统计日期。",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "monitor_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "store_report",
      "description": "保存基于真实消息生成的日报。采集失败不能记成无新增；不执行飞书发送。正文、状态和统计须与证据一致。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor_id": {
            "type": "string",
            "description": "监测方案编号，来自 list_monitors。"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "来自最新方案的 revision。配置改变后重新获取，不能猜测。"
          },
          "report_date": {
            "type": "string",
            "description": "按方案时区计算的 YYYY-MM-DD 统计日期。",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no_new",
              "collection_failed"
            ],
            "description": "正常、有核实依据的无新增、或采集失败。"
          },
          "body": {
            "type": "string",
            "description": "完整的日报正文，最多 24000 字符。",
            "maxLength": 24000
          },
          "message_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "已核实消息数；不确定时填 null，无新增须为 0。"
          },
          "coverage": {
            "type": "string",
            "description": "实际覆盖范围、缺口、来源证据与检索方法。"
          }
        },
        "required": [
          "monitor_id",
          "expected_revision",
          "report_date",
          "status",
          "body",
          "message_count"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "begin_delivery",
      "description": "在已经获授权并保存真实日报后，为单一配置目标占用一次投递。仅 state=claimed 才可发送，使用返回正文和 uuid；already_sent 或 needs_review 时不能重复发送。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor_id": {
            "type": "string",
            "description": "监测方案编号，来自 list_monitors。"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "description": "来自最新方案的 revision。配置改变后重新获取，不能猜测。"
          },
          "report_date": {
            "type": "string",
            "description": "按方案时区计算的 YYYY-MM-DD 统计日期。",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "recipient_key": {
            "type": "string",
            "description": "prepare_run 返回的接收目标 key，逐字传回。"
          }
        },
        "required": [
          "monitor_id",
          "expected_revision",
          "report_date",
          "recipient_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "complete_delivery",
      "description": "写回外部消息工具的真实投递结果。sent 必须提供实际 message_id；未知结果记 uncertain 并停止重发。不得用生成的编号代替回执。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor_id": {
            "type": "string",
            "description": "监测方案编号，来自 list_monitors。"
          },
          "report_date": {
            "type": "string",
            "description": "按方案时区计算的 YYYY-MM-DD 统计日期。",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "recipient_key": {
            "type": "string",
            "description": "prepare_run 返回的接收目标 key，逐字传回。"
          },
          "delivery_token": {
            "type": "string",
            "description": "begin_delivery 返回的实际投递凭证。"
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "failed",
              "uncertain"
            ],
            "description": "真实发送成功、已确定未发送、或结果未知。"
          },
          "message_id": {
            "type": "string",
            "description": "外部飞书工具实际返回的 om_ 消息编号；成功必填。"
          },
          "chat_id": {
            "type": "string",
            "description": "实际返回的会话编号；发送到群聊时必须与配置一致。"
          },
          "sender_id": {
            "type": "string",
            "description": "实际回执中的发送账号或机器人编号。"
          },
          "note": {
            "type": "string",
            "description": "失败原因或必要的回执说明，不含凭据。"
          }
        },
        "required": [
          "monitor_id",
          "report_date",
          "recipient_key",
          "delivery_token",
          "status"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_schedule",
      "description": "生成指定方案的每日 cron、时区和执行提示，供用户在 Cindy 自动化页保存，或由已获用户授权的当前 Agent 用 Cindy 原生调度工具创建。不代表已启用。",
      "parameters": {
        "type": "object",
        "properties": {
          "monitor_id": {
            "type": "string",
            "description": "监测方案编号，来自 list_monitors。"
          }
        },
        "required": [
          "monitor_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
